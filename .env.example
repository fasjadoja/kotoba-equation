# 公開URL（Vercelのドメイン or 独自ドメイン）
NEXT_PUBLIC_SITE_URL=https://example.com

# 寄付ページのURL（Buy Me a Coffee / OFUSE / Ko-fi など）。未設定なら寄付リンクは表示されません
NEXT_PUBLIC_DONATE_URL=

# 問い合わせ先URL（任意）
NEXT_PUBLIC_CONTACT_URL=

# 「みんなの作品」（任意公開ギャラリー）用の Supabase。両方設定したときだけ公開機能が表示されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
