# 公開URL（本番のドメイン。OGP・sitemap・Stripeのリダイレクトに使用）
NEXT_PUBLIC_SITE_URL=https://example.com

# Stripe（決済）
STRIPE_SECRET_KEY=sk_live_xxx
# 価格をStripe上のPriceで管理する場合に指定（未設定なら PRO_PRICE_JPY から動的に生成）
STRIPE_PRICE_ID=
PRO_PRICE_JPY=1980
NEXT_PUBLIC_PRO_PRICE_JPY=1980

# ライセンスキーの署名鍵（`openssl rand -hex 32` などで生成。変更すると発行済みキーが無効になります）
LICENSE_SECRET=

# Google AdSense（審査通過後に設定。未設定なら広告タグは読み込まれません）
NEXT_PUBLIC_ADSENSE_CLIENT=

# 特定商取引法に基づく表記（公開前に必ず実際の情報を設定）
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
