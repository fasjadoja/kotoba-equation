# 公開URL（Vercelのドメイン or 独自ドメイン）
NEXT_PUBLIC_SITE_URL=https://example.com

# 寄付ページのURL（Stripe Payment Link など）。未設定なら寄付リンクは表示されません
# Stripeなら日本語で開くよう ?locale=ja を付ける
NEXT_PUBLIC_DONATE_URL=

# 問い合わせ先URL（任意）
NEXT_PUBLIC_CONTACT_URL=

# 公式TikTokのURL（任意）。設定するとフッターと構造化データ（sameAs）に載ります
NEXT_PUBLIC_TIKTOK_URL=

# 寄付後のサポーター特典（ゴールドロゴ）を解錠する合言葉。
# 寄付ページのサンクスページ（戻り先）に {NEXT_PUBLIC_SITE_URL}/?thanks=この値 を設定します
NEXT_PUBLIC_SUPPORTER_KEY=

# 「みんなの作品」（任意公開ギャラリー）用の Supabase。両方設定したときだけ公開機能が表示されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
