# 公開URL（Vercelのドメイン or 独自ドメイン）
NEXT_PUBLIC_SITE_URL=https://example.com

# 寄付ページのURL（Stripe Payment Link など）。コードの既定値を上書きしたいときだけ設定します
# Stripeなら日本語で開くよう ?locale=ja を付ける。500円ぶんの決済リンク
NEXT_PUBLIC_DONATE_URL=

# 金額ちがいの決済リンク。未設定のときはコード内の既定リンクを使います
NEXT_PUBLIC_DONATE_URL_50=
NEXT_PUBLIC_DONATE_URL_100=
NEXT_PUBLIC_DONATE_URL_300=
NEXT_PUBLIC_DONATE_URL_10000=

# 金額を利用者が選ぶ決済リンク（50円×個数・最大3万円）
NEXT_PUBLIC_DONATE_URL_CUSTOM=

# 問い合わせ先URL（任意）
NEXT_PUBLIC_CONTACT_URL=

# 公式TikTokのURL（任意）。設定するとフッターと構造化データ（sameAs）に載ります
NEXT_PUBLIC_TIKTOK_URL=

# Google Search Console の「HTMLタグ」で表示される content の値（任意）。
# 設定すると所有権確認用の meta タグが全ページに入ります
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 寄付後の特典ロゴを解錠する合言葉。金額ごとの決済リンクの戻り先に
# {NEXT_PUBLIC_SITE_URL}/?thanks=この値 を設定します（50円以上=ゴールド、1万円以上=パトロン）
NEXT_PUBLIC_SUPPORTER_KEY=
NEXT_PUBLIC_PREMIUM_KEY=
NEXT_PUBLIC_ELITE_KEY=

# 「みんなの式」（任意公開ギャラリー）用の Supabase。両方設定したときだけ公開機能が表示されます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
